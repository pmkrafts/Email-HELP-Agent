# LLM refinement (optional). Without these values the pipeline runs fully offline
# in deterministic rules mode — that is the default and the mode used by the tests.
OPENAI_API_KEY=
EMAIL_AGENT_LLM=none          # none | openai
EMAIL_AGENT_MODEL=gpt-4o-mini
EMAIL_AGENT_BASE_URL=https://api.openai.com/v1
