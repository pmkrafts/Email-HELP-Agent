# Primary refinement (optional). Without these values the pipeline runs fully offline
# in deterministic rules mode — that is the default and the mode used by the tests.
# Any OpenAI-compatible provider works: openai, jev, a self-hosted gateway, ...
OPENAI_API_KEY=               # kept for convenience; EMAIL_AGENT_API_KEY overrides it
EMAIL_AGENT_LLM=none          # none | openai | jev | <gateway name>
EMAIL_AGENT_MODEL=gpt-4o-mini # e.g. jev-1.13 when the provider is jev
EMAIL_AGENT_BASE_URL=https://api.openai.com/v1

# Judge channel (optional) — the cheap "JEV" tier (model id: jev-1.13) that reviews classifications
# and routes only disagreements to the primary model.
EMAIL_AGENT_JUDGE_LLM=none          # none | jev | any label you like
EMAIL_AGENT_JUDGE_BASE_URL=         # e.g. https://<your-gateway>/v1
EMAIL_AGENT_JUDGE_API_KEY=
EMAIL_AGENT_JUDGE_MODEL=jev-1.13

# How the strong model is spent: "always" refines every classification (which JEV then verifies),
# "escalations_only" reserves it for judge disagreements (cost-first pairing).
EMAIL_AGENT_REFINE_MODE=always        # always | escalations_only

# Example — JEV as BOTH tiers (it can classify and judge):
#   EMAIL_AGENT_LLM=jev
#   EMAIL_AGENT_API_KEY=<gateway key>
#   EMAIL_AGENT_BASE_URL=<gateway>/v1
#   EMAIL_AGENT_MODEL=jev-1.13
#   EMAIL_AGENT_JUDGE_LLM=jev
#   EMAIL_AGENT_JUDGE_BASE_URL=<gateway>/v1
#   EMAIL_AGENT_JUDGE_API_KEY=<gateway key>
