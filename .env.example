# Primary refinement (optional). Without these values the pipeline runs fully offline
# in deterministic rules mode — that is the default and the mode used by the tests.
# Any OpenAI-compatible provider works: openai, jev, a self-hosted gateway, ...
OPENAI_API_KEY=               # kept for convenience; EMAIL_AGENT_API_KEY overrides it
EMAIL_AGENT_LLM=none          # none | openai | jev | <gateway name>
EMAIL_AGENT_MODEL=gpt-4o-mini # e.g. jev-1.13 when the provider is jev
EMAIL_AGENT_BASE_URL=https://api.openai.com/v1

# Judge channel (optional) — the cheap verification tier. Default target: Jev (System One) on
# OpenCode Zen. Jev does not chat: it evaluates typed questions (noul / choice / score) that the
# code builds (classification defensibility checks + draft-review checks).
EMAIL_AGENT_JUDGE_LLM=none                  # none | jev | any label you like
EMAIL_AGENT_JUDGE_BASE_URL=https://opencode.ai/zen/v1
EMAIL_AGENT_JUDGE_API_KEY=                  # falls back to OPENCODE_API_KEY, then EMAIL_AGENT_API_KEY
EMAIL_AGENT_JUDGE_MODEL=jev-1.13            # or jev-1.13-free
EMAIL_AGENT_JUDGE_API=auto                  # auto | systemone (Jev) | chat (OpenAI-compatible judge)
# TypeSafe direct instead of Zen: EMAIL_AGENT_JUDGE_BASE_URL=https://api.typesafe.ai/v1 (model jev-latest)

# How the strong model is spent: "always" refines every classification (which the judge then
# verifies), "escalations_only" reserves it for judge disagreements (cost-first pairing).
EMAIL_AGENT_REFINE_MODE=always        # always | escalations_only

# NOTE: Jev cannot be the primary model — it evaluates questions, it does not generate text.
# For the primary tier use a chat model (OpenAI, or a chat model from any gateway).
