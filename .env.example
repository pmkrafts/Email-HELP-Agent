# LLM refinement (optional). Without these values the pipeline runs fully offline
# in deterministic rules mode — that is the default and the mode used by the tests.
OPENAI_API_KEY=
EMAIL_AGENT_LLM=none          # none | openai
EMAIL_AGENT_MODEL=gpt-4o-mini
EMAIL_AGENT_BASE_URL=https://api.openai.com/v1

# Judge channel (optional) — the cheap "JEV" tier that reviews classifications and routes only
# disagreements to the primary model. Any OpenAI-compatible endpoint works (JEV, local model, ...).
EMAIL_AGENT_JUDGE_LLM=none          # none | jev | any label you like
EMAIL_AGENT_JUDGE_BASE_URL=         # e.g. https://jev.example/v1
EMAIL_AGENT_JUDGE_API_KEY=
EMAIL_AGENT_JUDGE_MODEL=            # e.g. jev-small
